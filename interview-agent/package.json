{
  "name": "roboapply-interview-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RoboApply Interview Engine — LiveKit voice worker (Node/TS). The metadata-driven AI interviewer.",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/main.js dev",
    "start": "node dist/main.js start",
    "console": "npm run build && node dist/main.js console",
    "verify:greeting": "node verify-greeting.mjs",
    "verify:voices": "node verify-voices.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.6.2",
    "@livekit/agents-plugin-openai": "1.6.2",
    "@livekit/agents-plugin-silero": "1.6.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@livekit/rtc-ffi-bindings-darwin-arm64": "^0.12.60"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.24.3": true,
    "@livekit/local-inference@0.2.6": true
  }
}
