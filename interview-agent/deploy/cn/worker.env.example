# GoApply interview voice worker — runtime env (copy to a secret store; never
# commit real values). Everything per interview (prompt, language, models,
# voice) still arrives in the room metadata from the GoApply control plane.

# ── LiveKit: the GoApply project (NOT RoboApply's) ──────────────────────────
# CN-0: a separate LiveKit Cloud project in an Asia region.
# CN-1: the self-hosted LiveKit server in Shanghai (ICP domain, TURN/TLS 443).
# Values = the control plane's CN_LIVEKIT_URL / CN_LIVEKIT_API_KEY / CN_LIVEKIT_API_SECRET.
LIVEKIT_URL=wss://livekit.example.cn
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Registration name. MUST equal the control plane's CN_INTERVIEW_ENGINE_AGENT_NAME
# (default GoApply-Interview). The deploy/cn image already sets it.
INTERVIEW_ENGINE_AGENT_NAME=GoApply-Interview
# Brand guard: with this (or the agent name above) the worker refuses every
# LiveKit gateway backend in code, whatever the backend pins below say.
WORKER_BRAND=goapply

# Callback secret. MUST equal the control plane's CN_LIVEKIT_AGENT_CALLBACK_SECRET
# (the worker always reads the unprefixed name; one worker serves one brand).
LIVEKIT_AGENT_CALLBACK_SECRET=

# ── Backend switch (pinned by the deploy/cn image; repeated for other hosts) ─
LLM_BACKEND=openai_compatible
STT_BACKEND=dashscope_paraformer
TTS_BACKEND=dashscope_cosyvoice

# ── Domestic LLM (live interviewer turns) ───────────────────────────────────
# The control plane names the model (CN_LLM_INTERVIEW_LIVE_MODEL, else
# CN_LLM_INTERVIEW_MODEL), e.g. deepseek/deepseek-chat or qwen/qwen-plus. The
# vendor prefix picks the endpoint and key below; set only the vendors you use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# KIMI_API_KEY=
# GLM_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=
# Optional per-vendor endpoint overrides (same names as the control plane):
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Or one endpoint for every model (e.g. a self-hosted gateway in the mainland).
# LLM_BASE_URL needs its own LLM_API_KEY: vendor keys are never sent to it.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=            # only used when the metadata names no model
# Extra mainland hosts the worker may call (comma list), e.g. that gateway:
# DOMESTIC_HOSTS=

# ── DashScope speech (Paraformer STT, CosyVoice TTS) ────────────────────────
# DASHSCOPE_API_KEY above also authenticates speech. Mainland endpoint only.
# DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
# DASHSCOPE_WORKSPACE=
# Default CosyVoice voices when the control plane sends none
# (CN_INTERVIEW_ENGINE_TTS_VOICE[_MALE] there wins). Built-in defaults exist
# for cosyvoice-v1/-v2 only; set these for any other generation.
# COSYVOICE_VOICE_ZH_FEMALE=longxiaochun_v2
# COSYVOICE_VOICE_ZH_MALE=longcheng_v2

# Not used by this worker (no OpenAI floor for DashScope voices). Leave unset.
# OPENAI_API_KEY=

# ── Tuning (optional; same as the RoboApply worker) ─────────────────────────
# WORKER_NUM_IDLE_PROCESSES=1
# WORKER_DRAIN_TIMEOUT_MS=
# WORKER_CLIENT_READY_TIMEOUT_MS=5000
