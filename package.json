{
  "name": "roboapply",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "RoboApply — AI candidate-facing job-application app (Next.js frontend + Express API, deployed on Vercel).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGINT \"npm run dev:server\" \"npm run dev:web:after-api\" \"./scripts/dev-interview-agent.sh\"",
    "dev:web": "next dev -p 3611",
    "dev:web:after-api": "tsx scripts/dev-web-after-api.ts",
    "dev:server": "tsx watch server/src/app.ts",
    "dev:interview-agent": "npm --prefix interview-agent run dev",
    "build": "prisma generate && npm run build:server && next build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "next build",
    "start": "next start -p ${PORT:-3611}",
    "lint": "next lint",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:design": "node scripts/check-design.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:llm-costs": "tsx scripts/print-llm-costs.ts --check",
    "check:api-boundary": "node scripts/check-api-boundary.mjs",
    "check:extension": "node scripts/check-extension-no-submit.mjs",
    "check:zh-variants": "node scripts/check-zh-variants.mjs",
    "check": "npm run check:design && npm run check:copy && npm run check:llm-costs && npm run check:api-boundary && npm run check:extension && npm run check:zh-variants",
    "i18n:merge": "node scripts/i18n-merge-staging.mjs",
    "llm:costs": "tsx scripts/print-llm-costs.ts",
    "gen:brand": "node scripts/gen-brand-mirror.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "//": "Build-time deps (tailwind/postcss/typescript/@types) live in dependencies so a production (NODE_ENV=production) install does not prune what `next build` and `tsc -p server` need.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sts": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@google/genai": "^2.28.0",
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.2.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/protocol": "^1.52.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tavily/core": "^0.7.14",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/functions": "3.9.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "disposable-email-domains": "^1.0.62",
    "docx": "^9.9.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "free-email-domains": "^1.12.23",
    "html-to-text": "^10.0.1",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "node-cron": "^4.6.0",
    "openai": "^7.31.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "web-push": "3.6.7",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "3.6.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "free-email-domains@1.12.23": true,
    "prisma@7.10.0": true,
    "@google/genai@2.28.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.13": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "@parcel/watcher@2.6.0": true
  }
}
