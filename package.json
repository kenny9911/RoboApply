{
  "name": "roboapply",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "RoboApply — AI candidate-facing job-application app (Next.js frontend + Express API, deployed on Vercel).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGINT \"npm run dev:server\" \"npm run dev:web:after-api\" \"./scripts/dev-interview-agent.sh\"",
    "dev:web": "next dev -p 3611",
    "dev:web:after-api": "tsx scripts/dev-web-after-api.ts",
    "dev:server": "tsx watch server/src/app.ts",
    "dev:interview-agent": "npm --prefix interview-agent run dev",
    "build": "prisma generate && npm run build:server && next build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "next build",
    "start": "next start -p ${PORT:-3611}",
    "lint": "next lint",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:design": "node scripts/check-design.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:llm-costs": "tsx scripts/print-llm-costs.ts --check",
    "check": "npm run check:design && npm run check:copy && npm run check:llm-costs",
    "llm:costs": "tsx scripts/print-llm-costs.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "//": "Build-time deps (tailwind/postcss/autoprefixer/typescript/@types) live in dependencies so a production (NODE_ENV=production) install does not prune what `next build` and `tsc -p server` need.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-sts": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.2.0",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/protocol": "^1.46.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tavily/core": "^0.7.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "disposable-email-domains": "^1.0.62",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "free-email-domains": "^1.9.93",
    "html-to-text": "^10.0.0",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.10",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "node-cron": "^4.6.0",
    "openai": "^4.67.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^6.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "free-email-domains@1.9.93": true,
    "prisma@7.9.1": true,
    "protobufjs@7.6.4": true,
    "@google/genai@2.16.0": true,
    "@parcel/watcher@2.5.6": true,
    "@prisma/engines@7.9.1": true,
    "@swc/core@1.15.43": true,
    "fsevents@2.3.3": true
  }
}
