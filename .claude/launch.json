{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3611
    },
    {
      "name": "design-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/design-preview.mjs"
      ],
      "port": 3612
    },
    {
      "name": "parley",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../parley && PORT=8080 PUBLIC_URL=http://localhost:8080 PARLEY_DATA_DIR=./data/roboapply-pilot PARLEY_ADMIN_PASSWORD=${PARLEY_ADMIN_PASSWORD:-dev} npm run dev"
      ],
      "port": 8080
    }
  ]
}
