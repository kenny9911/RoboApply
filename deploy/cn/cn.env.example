# deploy/cn/cn.env.example — what the GoApply mainland stack (CN-1) needs at
# minimum, as variable NAMES only (WP-76). The full catalogue with comments is
# the repository-root .env.example; CN_TW_LAUNCH_PLAN.md §5.2/§5.3 says which
# account each value comes from.
#
# The web pods get their own, smaller Secret: deploy/cn/cn.web.env.example.
#
# Copy to deploy/cn/.env.cn (git-ignored), fill it, then either
#   kubectl -n goapply create secret generic goapply-api-env --from-env-file=deploy/cn/.env.cn
# or use it with deploy/cn/compose.yaml. Never commit a filled copy.
#
# Fixed by the manifests (do not set here): NODE_ENV, PORT, DEPLOY_REGION=cn-mainland,
# ALLOWED_BRANDS=goapply, ROBOAPPLY_CRON_DISABLED=true, FILE_LOGGING=false.

# ── Database (Aliyun RDS PostgreSQL, cn-shanghai; VPC address preferred) ──
DATABASE_URL=
DIRECT_DATABASE_URL=
# Only when the host is not a VPC/private address or a default RDS suffix:
CN_ALLOWED_DB_HOST_SUFFIXES=

# ── Platform secrets (generate fresh values for the mainland stack) ──
JWT_SECRET=
CRON_SECRET=
INTERNAL_API_SECRET=
SENSITIVE_DATA_KEY=
CN_RA_SYSTEM_USER_ID=

# ── Origins ──
CN_CANONICAL_ORIGIN=https://www.goapply.top
CN_COOKIE_DOMAIN=
# Baidu link push for the seo-rebuild cron (optional):
CN_BAIDU_PUSH_TOKEN=

# ── Legal display + residency assertions (startup refuses without CN_ICP_NUMBER) ──
CN_ICP_NUMBER=
CN_PSB_NUMBER=
CN_PSB_RECORD_CODE=
CN_LEGAL_ENTITY_NAME=
CN_LEGAL_POSTAL_ADDRESS=
CN_LEGAL_DOCS_VERSION=
CN_COMPLAINT_EMAIL=
CN_COMPLAINT_PHONE=
CN_SUPPORT_EMAIL=
CN_GENAI_DISCLOSURES=
CN_GENAI_APP_REGISTRATION_NO=

# ── Stage switches ──
CN_SIGNUP_MODE=open
CN_RECRUITMENT_INFO_MODE=off
CN_PAYMENTS_ENABLED=false

# ── Object storage (Aliyun OSS, S3-compatible endpoint; no fallback to S3_*) ──
CN_S3_ENDPOINT=
CN_S3_REGION=
CN_S3_BUCKET=
CN_S3_ACCESS_KEY_ID=
CN_S3_SECRET_ACCESS_KEY=
CN_S3_FORCE_PATH_STYLE=
CN_PUBLIC_ASSET_BASE_URL=

# ── Domestic LLMs (allowlist only; nothing offshore) ──
CN_LLM_PROVIDER=
CN_LLM_MODEL=
CN_LLM_FALLBACK_MODEL=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ── Content safety (CN-1 preflight requires aliyun_green with keys) ──
CN_CONTENT_SAFETY_PROVIDER=aliyun_green
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION=cn-shanghai
CN_SAFETY_KEYWORDS_URL=

# ── Email (Aliyun DirectMail; resend is refused on the mainland) ──
CN_EMAIL_TRANSPORT=aliyun_dm
CN_EMAIL_FROM=
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REGION=

# ── Phone login (Aliyun SMS) and WeChat ──
CN_SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_OTP=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# ── Voice practice (only with the CN LiveKit; see deploy/cn/k8s/worker.yaml) ──
CN_VOICE_PROVIDER=
CN_LIVEKIT_URL=
CN_LIVEKIT_API_KEY=
CN_LIVEKIT_API_SECRET=
CN_LIVEKIT_AGENT_CALLBACK_SECRET=
CN_INTERVIEW_ENGINE_CALLBACK_BASE_URL=
CN_INTERVIEW_ENGINE_AGENT_NAME=GoApply-Interview

# ── GoHire (resume parsing for GoApply; bank only over TLS) ──
GOHIRE_PARSE_BRANDS=goapply
GOHIRE_API_KEY=
DATABASE_URL_GOHIRE=
