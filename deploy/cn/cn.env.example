# deploy/cn/cn.env.example — the API environment of the GoApply mainland stack,
# as variable NAMES only (WP-76). The full catalogue with comments is the
# repository-root .env.example.
#
# The web pods get their own, smaller Secret: deploy/cn/cn.web.env.example.
#
# Copy to deploy/cn/.env.cn (git-ignored), fill it, then either
#   kubectl -n goapply create secret generic goapply-api-env --from-env-file=deploy/cn/.env.cn
# or use it with deploy/cn/compose.yaml. Never commit a filled copy.
#
# WHAT IS REQUIRED (owner ruling D5; docs/jobright-clone/GOAPPLY_PARITY_PLAN.md).
# Only topology and the shared credentials:
#   1. a database inside the mainland (section "Database"),
#   2. the platform secrets,
#   3. the shared credentials GoApply runs on (section "Shared stack").
# With those three the preflight passes with warnings and GoApply works: AI,
# email, voice practice, uploads, the job feed, open sign-up and its plans.
# No China-specific provider, licence number or stage switch is a prerequisite.
# Every CN_<NAME> value below is an OPTIONAL override of <NAME>; unset means
# the shared stack. The preflight (deploy/cn/preflight.mjs) refuses only a wrong
# topology; everything else it reports as a warning, unless the operator sets
# the strict posture (CN_RESIDENCY_STRICT=true, the last section).
#
# Fixed by the manifests (do not set here): NODE_ENV, PORT, DEPLOY_REGION=cn-mainland,
# ALLOWED_BRANDS=goapply, ROBOAPPLY_CRON_DISABLED=true, FILE_LOGGING=false.
# ALLOWED_BRANDS must stay goapply on this stack: RoboApply is never served from
# the mainland, and a value that names no valid brand resolves to RoboApply
# only, which the preflight refuses (intl_brand_on_mainland).
#
# Leave unset: TRUST_PROXY (the API trusts one hop off Vercel, which is the
# gateway) and SHUTDOWN_DRAIN_TIMEOUT_MS (the default fits the pod's 330 s
# grace period). Not in this Secret: the interview worker's variables
# (Secret goapply-worker-env, interview-agent/deploy/cn/worker.env.example) and
# the web image's build-time values (see cn.web.env.example).

# ── Database (required; Aliyun RDS PostgreSQL, cn-shanghai; VPC address preferred) ──
DATABASE_URL=
DIRECT_DATABASE_URL=
# Only when the host is not a VPC/private address or a default RDS suffix:
CN_ALLOWED_DB_HOST_SUFFIXES=
# Optional tuning, defaults fit a long-running host (root .env.example):
# PRISMA_POOL_MAX=
# PRISMA_TX_MAX_WAIT_MS=
# PRISMA_TX_TIMEOUT_MS=

# ── Platform secrets (generate fresh values for the mainland stack) ──
# JWT_SECRET and CRON_SECRET are required (the preflight refuses without
# CRON_SECRET: every CronJob call would be rejected).
JWT_SECRET=
CRON_SECRET=
INTERNAL_API_SECRET=
SENSITIVE_DATA_KEY=
# System user for system-owned records (either name works on this stack).
CN_RA_SYSTEM_USER_ID=

# ── Origins ──
CN_CANONICAL_ORIGIN=https://www.goapply.top
CN_COOKIE_DOMAIN=
# Baidu link push for the seo-rebuild cron (optional):
CN_BAIDU_PUSH_TOKEN=

# ── Shared stack: what GoApply runs on when no China-specific provider is set ──
# The same names RoboApply uses. Each group below can be replaced later by its
# optional CN_ override without touching the others.
# Models (any provider the shared stack supports, with its key):
LLM_PROVIDER=
LLM_MODEL=
OPENROUTER_API_KEY=
# Email (Resend) and the verified sender of that Resend account. GoApply mail
# goes out from this address under the display name GoApply until CN_EMAIL_FROM
# names a verified goapply.top sender. Without it the sender is
# noreply@goapply.top, which Resend refuses while that domain is unverified:
# verification and password-reset mail would not be delivered.
RESEND_API_KEY=
ROBOAPPLY_EMAIL_FROM=
# Voice and video practice (LiveKit project, its worker and callback secret):
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_CALLBACK_SECRET=
INTERVIEW_ENGINE_AGENT_NAME=
INTERVIEW_ENGINE_CALLBACK_BASE_URL=
# Object storage (resume originals, photos, practice recordings):
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Web push:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Whether an offshore provider answers quickly, or at all, from a mainland
# network is for the operator to measure. The optional overrides below exist
# for latency and deliverability inside China, not to switch a feature on.

# ── Payments (Alipay, the existing rail) ──
# The rail's own credential: with it GoApply opens payments; without it the
# plans and prices still show. ALIPAY_API_URL only when the worker is not the
# default one.
ALIPAY_CALLBACK_SECRET=
ALIPAY_API_URL=
# Printed on orders and receipts when set (the Alipay merchant should be the
# GoApply operating entity); not a gate.
CN_PAYMENT_COLLECTING_ENTITY=
# Origin the payment worker posts the callback to; unset = CN_CANONICAL_ORIGIN.
CN_BACKEND_URL=

# ── Job sources ──
# The feed is on by default and is filled by public employer boards (their
# documented job-board APIs, postings located in mainland China). This needs
# no key, only outbound HTTPS from the API pods to those boards.
# GoHire: resume parsing for GoApply, and the GoHire job bank. Its jobs are
# synced over HTTPS with GOHIRE_API_KEY (or the database below when it has TLS)
# and are listed only once GOHIRE_PUBLIC_JOB_URL_TEMPLATE names GoHire's
# public posting page (root .env.example); until then they are held and counted.
GOHIRE_PARSE_BRANDS=goapply
GOHIRE_API_KEY=
DATABASE_URL_GOHIRE=
# The GoHire bank is read only with this set to true (the cross-tenant guard
# of the root .env.example). Without it the bank is skipped and the feed still
# fills from the employer boards.
RA_CROSSBANK_CROSS_TENANT_CONFIRMED=

# ── Legal display (optional; each line is printed only when set) ──
# A missing CN_ICP_NUMBER is a preflight warning, not a refusal. The filings
# themselves are the owner's legal track (docs/runbooks/cn-deploy.md).
CN_ICP_NUMBER=
CN_PSB_NUMBER=
CN_PSB_RECORD_CODE=
CN_LEGAL_ENTITY_NAME=
CN_LEGAL_POSTAL_ADDRESS=
# Unset = the legal documents are served as drafts with the DRAFT banner.
CN_LEGAL_DOCS_VERSION=
CN_COMPLAINT_EMAIL=
CN_COMPLAINT_PHONE=
CN_SUPPORT_EMAIL=
# Address the legal documents give for takedown notices; unset → CN_SUPPORT_EMAIL.
CN_TAKEDOWN_CONTACT=
CN_GENAI_DISCLOSURES=
CN_GENAI_APP_REGISTRATION_NO=

# ── Optional override: object storage (Aliyun OSS, S3-compatible endpoint) ──
# Unset = the shared store above. One group, anchored on CN_S3_BUCKET: set it
# and the other storage values are read from CN_S3_* only; without it they are
# ignored.
CN_S3_ENDPOINT=
CN_S3_REGION=
CN_S3_BUCKET=
CN_S3_ACCESS_KEY_ID=
CN_S3_SECRET_ACCESS_KEY=
CN_S3_FORCE_PATH_STYLE=
# CN_PUBLIC_ASSET_BASE_URL is not read by the API: it is a build-time value of
# the web image (repository variable; see cn.web.env.example).

# ── Optional override: domestic LLMs ──
# Unset = the shared models above. Each CN_LLM_* setting overrides its LLM_*
# twin per key. CN_LLM_MODEL by itself starts GoApply's own profile, where the
# shared LLM_PROVIDER is not used: write it with a vendor prefix
# (deepseek/deepseek-chat) or set CN_LLM_PROVIDER. A bare id with no
# CN_LLM_PROVIDER has no route (GoApply AI answers 503; boot logs an error).
CN_LLM_PROVIDER=
CN_LLM_MODEL=
CN_LLM_FALLBACK_MODEL=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ── Optional override: content safety (Aliyun Green) ──
# The filter always runs on GoApply model calls; unset = the built-in keyword
# list. To use Aliyun Green set the provider and its keys together:
# CN_CONTENT_SAFETY_PROVIDER=aliyun_green
# ALIYUN_GREEN_REGION=cn-shanghai
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
CN_SAFETY_KEYWORDS_URL=

# ── Optional override: email (Aliyun DirectMail) ──
# Unset = Resend through RESEND_API_KEY above, sent from ROBOAPPLY_EMAIL_FROM
# (the shared verified sender) under the name GoApply. CN_EMAIL_FROM is
# GoApply's own sender: set it once a goapply.top sender is verified on the
# transport in use. To use DirectMail set the transport, its keys and
# CN_EMAIL_FROM together (the shared sender is never borrowed there):
# CN_EMAIL_TRANSPORT=aliyun_dm
CN_EMAIL_FROM=
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REGION=
# Lifecycle mail "your resume check is ready": ISO time the resume-check view
# stamp went live on this stack (same name on both brands, no CN_ prefix).
# Unset = that message is never sent.
RESUME_CHECK_VIEW_SIGNAL_SINCE=

# ── Optional additional sign-in methods: phone (Aliyun SMS) and WeChat ──
# Email + password sign-up works without these. Each method appears beside it
# only when its own values are set.
# CN_SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_OTP=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# ── Optional override: GoApply's own media plane (see deploy/cn/k8s/worker.yaml) ──
# Unset = the shared LiveKit project above and its worker. One group, anchored
# on CN_LIVEKIT_URL: set it and the key, secret, callback secret, callback base
# URL, agent name and provider are read from CN_* only; without it they are
# ignored. The kit's worker Deployment (GoApply-Interview, 0 replicas) is for
# this own plane.
CN_VOICE_PROVIDER=
CN_LIVEKIT_URL=
CN_LIVEKIT_API_KEY=
CN_LIVEKIT_API_SECRET=
CN_LIVEKIT_AGENT_CALLBACK_SECRET=
CN_INTERVIEW_ENGINE_CALLBACK_BASE_URL=
# Set together with CN_LIVEKIT_URL (the name the kit's worker registers under):
# CN_INTERVIEW_ENGINE_AGENT_NAME=GoApply-Interview
# Models for a voice session: unset = the shared interview routing and the
# shared speech models. The two speech models are one group (set both, e.g.
# dashscope/paraformer-realtime-v2 and dashscope/cosyvoice-v2, or neither).
CN_LLM_INTERVIEW_MODEL=
CN_LLM_INTERVIEW_LIVE_MODEL=
CN_INTERVIEW_ENGINE_STT_MODEL=
CN_INTERVIEW_ENGINE_TTS_MODEL=

# ── Optional override: job matching ──
# Unset = the shared values, so GoApply's fit estimate works with nothing set
# here. Starting priors of the estimate (JSON, title_level / skills / industry
# / logistics / career_path; the meaning and the defaults are in the root
# .env.example). Optional: unset = MATCH_PRIORS, then the defaults in code.
# CN_MATCH_PRIORS=

# ── Strict mainland posture (optional; only for an operator who has the ──
# ── domestic providers above) ──
# Off by default and never implied by a missing value. On the shared stack
# GoApply resumes, prompts and practice media are processed by the same
# offshore processors as RoboApply; the sign-up consent and the processor list
# are generated from the stack in use and say so. Whether the mainland
# deployment should run strict is a decision for counsel and the owner
# (GOAPPLY_PARITY_PLAN.md section 8, item 3). Uncomment to keep
# GoApply personal data on mainland endpoints only. With CN_RESIDENCY_STRICT
# the preflight and the API boot refuse again when the ICP number, a mainland
# bucket, a mainland model route, Aliyun Green or a mainland email transport is
# missing, and uploads and practice recordings are refused without a mainland
# bucket of GoApply's own (the four CN_S3_* values, CN_S3_ENDPOINT on mainland
# object storage). The switch is supported with DEPLOY_REGION=cn-mainland only:
# the provider checks at boot run on a mainland deployment.
# CN_RESIDENCY_STRICT=true
# GoApply may call mainland model endpoints only (implied by the line above):
# CN_LLM_DOMESTIC_ONLY=true
# What is kept of an uploaded resume: store (default) | redact | discard:
# CN_STORAGE_MODE=redact
