# Build context for deploy/cn/Dockerfile.web (BuildKit reads <Dockerfile>.dockerignore
# next to the Dockerfile). The web build needs most of the repo (next build type-checks
# everything tsconfig.json includes), so this is a deny list. Secrets and local state
# never enter the context.

# ── secrets and local env (never in an image) ──
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/kubeconfig*

# ── VCS, agents, editor and platform state ──
.git
.github
.claude
.codex
.agents
.gstack
.vercel
**/.DS_Store

# ── installs and build output (rebuilt inside the image) ──
**/node_modules
.next
out
coverage
logs
output
server/dist
server/src/generated
*.tsbuildinfo

# ── not part of the web build ──
docs
e2e
rules-research
interview-agent
extension
deploy
