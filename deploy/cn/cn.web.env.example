# deploy/cn/cn.web.env.example — what the GoApply WEB pods (Next.js server)
# read at runtime on the mainland stack, as variable NAMES only (WP-76).
#
# Copy to deploy/cn/.env.cn.web (git-ignored), fill it, then
#   kubectl -n goapply create secret generic goapply-web-env --from-env-file=deploy/cn/.env.cn.web
# Never commit a filled copy. Do not put database or vendor credentials here.
#
# Nothing here is a prerequisite for GoApply to work (owner ruling D5): the web
# pods need only INTERNAL_API_SECRET to talk to the API. The legal values are
# brand-own display lines, each printed only when set. No China-specific
# provider credential belongs in this Secret.
#
# Fixed by deploy/cn/k8s/web.yaml (do not set here): NODE_ENV, PORT, HOSTNAME,
# DEPLOY_REGION=cn-mainland, ALLOWED_BRANDS=goapply, NEXT_PUBLIC_API_URL.
# ALLOWED_BRANDS stays goapply on this stack (a value that names no valid brand
# resolves to RoboApply only, which the mainland stack never serves).
#
# Build-time, NOT read from this Secret (`next build` bakes them into the
# image; .github/workflows/deploy-cn.yml passes them as build arguments):
#   CN_PUBLIC_ASSET_BASE_URL   repository variable; the https origin GoApply images
#                              are served from (OSS bucket or CDN). next.config.mjs
#                              turns it into the one extra host next/image may load.
#   NEXT_DEPLOYMENT_ID         set to the git SHA; lets Next.js detect a browser
#                              talking to a web pod of another release during a rollout.
#   NEXT_PUBLIC_CN_EXT_ID, NEXT_PUBLIC_CN_EXT_STORE_URL   repository variables (extension links).

# ── Server-side calls to the API (same value as the API's INTERNAL_API_SECRET) ──
INTERNAL_API_SECRET=

# ── Origins and search engines ──
CN_CANONICAL_ORIGIN=https://www.goapply.top
# Baidu webmaster verification token (lib/brand/metadata.ts; no CN_ prefix).
BAIDU_SITE_VERIFICATION=
# Only when serving extra hostnames (lib/brand):
BRAND_HOST_MAP=

# ── Legal pages (/legal/[doc], app/legal/legalSource.ts) ──
# Same values as the API's. The pages are served either way: unset, the GoApply
# privacy policy and terms show 未披露 for the operator and complaint contacts
# and are marked as drafts (草稿). A public launch needs the real values for the
# PIPL disclosure (C-5), so check /legal/privacy after every deploy.
CN_LEGAL_ENTITY_NAME=
CN_LEGAL_POSTAL_ADDRESS=
CN_SUPPORT_EMAIL=
CN_COMPLAINT_EMAIL=
CN_COMPLAINT_PHONE=
CN_LEGAL_DOCS_VERSION=
# Address the legal pages give for takedown notices; unset → CN_SUPPORT_EMAIL.
CN_TAKEDOWN_CONTACT=
