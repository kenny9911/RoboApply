exports[`batch upsert SQL (snapshot) > is one INSERT … ON CONFLICT … RETURNING (xmax = 0) for the whole batch 1`] = `"INSERT INTO "RAJob" ("id", "externalId", "sourceBoard", "applyUrl", "title", "titleNormalized", "companyName", "companyNameNormalized", "companyLogoUrl", "location", "locationCity", "locationCountry", "workType", "employmentType", "salaryMin", "salaryMax", "salaryCurrency", "salaryPeriod", "description", "descriptionPlain", "postedAt", "market", "visibility", "companyId", "taxonomyIds", "primaryTaxonomyId", "titleMatchScore", "seniority", "roleType", "minYears", "maxYears", "skills", "workModel", "remoteScope", "locationRegion", "locations", "geoLat", "geoLng", "salarySource", "salaryAnnualMin", "salaryAnnualMax", "salaryMonths", "salaryDisclosed", "salaryText", "sourceUrl", "sourceName", "originalSourceName", "originalHost", "atsType", "isAgency", "fromRecruiterBank", "employerVerified", "applicantCount", "applicantCountSource", "applicantCountAt", "postedAtEstimated", "expiresAt", "dedupeKey", "sourcePriority", "searchText", "publicDisplay", "fraudFlags", "marketTags", "educationLevel", "atsPostingKey", "locationDistrict", "workShift", "headcount", "sponsorship", "sponsorshipSource", "firstSeenAt", "lastSeenAt", "updatedAt") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9::text, $10::text, $11::text, $12::text, $13, $14::text, $15::int, $16::int, $17::text, $18::text, $19, $20, $21::timestamp(3), $22, $23, $24::text, $25::text[], $26::text, $27::real, $28::text, $29::text, $30::int, $31::int, $32::text[], $33::text, $34::text, $35::text, $36::jsonb, $37::double precision, $38::double precision, $39::text, $40::int, $41::int, $42::int, $43::boolean, $44::text, $45::text, $46::text, $47::text, $48::text, $49::text, $50::boolean, $51::boolean, $52::boolean, $53::int, $54::text, $55::timestamp(3), $56::boolean, $57::timestamp(3), $58, $59::int, $60, $61::boolean, $62::jsonb, $63::jsonb, $64::text, $65::text, $66::text, $67::text, $68::int, $69::text, $70::text, now(), now(), now()),($71, $72, $73, $74, $75, $76, $77, $78, $79::text, $80::text, $81::text, $82::text, $83, $84::text, $85::int, $86::int, $87::text, $88::text, $89, $90, $91::timestamp(3), $92, $93, $94::text, $95::text[], $96::text, $97::real, $98::text, $99::text, $100::int, $101::int, $102::text[], $103::text, $104::text, $105::text, $106::jsonb, $107::double precision, $108::double precision, $109::text, $110::int, $111::int, $112::int, $113::boolean, $114::text, $115::text, $116::text, $117::text, $118::text, $119::text, $120::boolean, $121::boolean, $122::boolean, $123::int, $124::text, $125::timestamp(3), $126::boolean, $127::timestamp(3), $128, $129::int, $130, $131::boolean, $132::jsonb, $133::jsonb, $134::text, $135::text, $136::text, $137::text, $138::int, $139::text, $140::text, now(), now(), now()) ON CONFLICT ("externalId", "sourceBoard") DO UPDATE SET "lastSeenAt" = now(), "updatedAt" = now(), "applyUrl" = EXCLUDED."applyUrl", "title" = EXCLUDED."title", "titleNormalized" = EXCLUDED."titleNormalized", "companyName" = EXCLUDED."companyName", "companyNameNormalized" = EXCLUDED."companyNameNormalized", "companyLogoUrl" = EXCLUDED."companyLogoUrl", "location" = EXCLUDED."location", "locationCity" = EXCLUDED."locationCity", "locationCountry" = EXCLUDED."locationCountry", "locationDistrict" = EXCLUDED."locationDistrict", "locationRegion" = EXCLUDED."locationRegion", "locations" = EXCLUDED."locations", "geoLat" = EXCLUDED."geoLat", "geoLng" = EXCLUDED."geoLng", "workType" = EXCLUDED."workType", "workModel" = EXCLUDED."workModel", "remoteScope" = EXCLUDED."remoteScope", "workShift" = EXCLUDED."workShift", "headcount" = EXCLUDED."headcount", "employmentType" = COALESCE(EXCLUDED."employmentType", "RAJob"."employmentType"), "salaryMin" = EXCLUDED."salaryMin", "salaryMax" = EXCLUDED."salaryMax", "salaryCurrency" = EXCLUDED."salaryCurrency", "salaryPeriod" = EXCLUDED."salaryPeriod", "salarySource" = EXCLUDED."salarySource", "salaryAnnualMin" = EXCLUDED."salaryAnnualMin", "salaryAnnualMax" = EXCLUDED."salaryAnnualMax", "salaryMonths" = EXCLUDED."salaryMonths", "salaryDisclosed" = EXCLUDED."salaryDisclosed", "salaryText" = EXCLUDED."salaryText", "description" = EXCLUDED."description", "descriptionPlain" = EXCLUDED."descriptionPlain", "postedAt" = EXCLUDED."postedAt", "postedAtEstimated" = EXCLUDED."postedAtEstimated", "expiresAt" = EXCLUDED."expiresAt", "market" = EXCLUDED."market", "companyId" = COALESCE(EXCLUDED."companyId", "RAJob"."companyId"), "taxonomyIds" = CASE WHEN cardinality(EXCLUDED."taxonomyIds") = 0 THEN "RAJob"."taxonomyIds" WHEN "RAJob"."enrichedAt" IS NULL OR cardinality("RAJob"."taxonomyIds") = 0 OR EXCLUDED."titleMatchScore" >= 0.9::real OR "RAJob"."titleNormalized" IS DISTINCT FROM EXCLUDED."titleNormalized" THEN EXCLUDED."taxonomyIds" ELSE "RAJob"."taxonomyIds" END, "primaryTaxonomyId" = CASE WHEN EXCLUDED."primaryTaxonomyId" IS NULL THEN "RAJob"."primaryTaxonomyId" WHEN "RAJob"."enrichedAt" IS NULL OR cardinality("RAJob"."taxonomyIds") = 0 OR EXCLUDED."titleMatchScore" >= 0.9::real OR "RAJob"."titleNormalized" IS DISTINCT FROM EXCLUDED."titleNormalized" THEN EXCLUDED."primaryTaxonomyId" ELSE "RAJob"."primaryTaxonomyId" END, "titleMatchScore" = EXCLUDED."titleMatchScore", "seniority" = COALESCE(EXCLUDED."seniority", "RAJob"."seniority"), "roleType" = COALESCE(EXCLUDED."roleType", "RAJob"."roleType"), "minYears" = COALESCE(EXCLUDED."minYears", "RAJob"."minYears"), "maxYears" = COALESCE(EXCLUDED."maxYears", "RAJob"."maxYears"), "skills" = CASE WHEN cardinality(EXCLUDED."skills") > 0 THEN EXCLUDED."skills" ELSE "RAJob"."skills" END, "educationLevel" = COALESCE(EXCLUDED."educationLevel", "RAJob"."educationLevel"), "sourceUrl" = EXCLUDED."sourceUrl", "sourceName" = EXCLUDED."sourceName", "originalSourceName" = EXCLUDED."originalSourceName", "originalHost" = EXCLUDED."originalHost", "atsType" = EXCLUDED."atsType", "atsPostingKey" = EXCLUDED."atsPostingKey", "sponsorship" = CASE WHEN "RAJob"."sponsorshipSource" = 'posting_quote' OR "RAJob"."sponsorshipEvidence" IS NOT NULL THEN "RAJob"."sponsorship" WHEN EXCLUDED."sponsorshipSource" IS NOT NULL THEN EXCLUDED."sponsorship" WHEN "RAJob"."sponsorshipSource" LIKE 'provider:%' THEN NULL ELSE "RAJob"."sponsorship" END, "sponsorshipSource" = CASE WHEN "RAJob"."sponsorshipSource" = 'posting_quote' OR "RAJob"."sponsorshipEvidence" IS NOT NULL THEN "RAJob"."sponsorshipSource" WHEN EXCLUDED."sponsorshipSource" IS NOT NULL THEN EXCLUDED."sponsorshipSource" WHEN "RAJob"."sponsorshipSource" LIKE 'provider:%' THEN NULL ELSE "RAJob"."sponsorshipSource" END, "isAgency" = COALESCE(EXCLUDED."isAgency", "RAJob"."isAgency"), "fromRecruiterBank" = EXCLUDED."fromRecruiterBank", "employerVerified" = EXCLUDED."employerVerified", "applicantCount" = EXCLUDED."applicantCount", "applicantCountSource" = EXCLUDED."applicantCountSource", "applicantCountAt" = EXCLUDED."applicantCountAt", "dedupeKey" = EXCLUDED."dedupeKey", "sourcePriority" = EXCLUDED."sourcePriority", "searchText" = EXCLUDED."searchText", "publicDisplay" = EXCLUDED."publicDisplay", "fraudFlags" = CASE WHEN EXCLUDED."fraudFlags" IS NULL OR jsonb_typeof(EXCLUDED."fraudFlags") <> 'array' OR jsonb_array_length(EXCLUDED."fraudFlags") = 0 THEN "RAJob"."fraudFlags" WHEN "RAJob"."fraudFlags" IS NULL OR jsonb_typeof("RAJob"."fraudFlags") <> 'array' THEN EXCLUDED."fraudFlags" ELSE "RAJob"."fraudFlags" || COALESCE(( SELECT jsonb_agg(n.e) FROM jsonb_array_elements(EXCLUDED."fraudFlags") AS n(e) WHERE NOT EXISTS (SELECT 1 FROM jsonb_array_elements("RAJob"."fraudFlags") AS o(e) WHERE o.e->>'rule' = n.e->>'rule' AND o.e->>'evidence' = n.e->>'evidence')), '[]'::jsonb) END, "marketTags" = CASE WHEN EXCLUDED."marketTags" IS NULL OR jsonb_typeof(EXCLUDED."marketTags") <> 'array' OR jsonb_array_length(EXCLUDED."marketTags") = 0 THEN "RAJob"."marketTags" WHEN "RAJob"."marketTags" IS NULL OR jsonb_typeof("RAJob"."marketTags") <> 'array' THEN EXCLUDED."marketTags" ELSE "RAJob"."marketTags" || COALESCE(( SELECT jsonb_agg(n.e) FROM jsonb_array_elements(EXCLUDED."marketTags") AS n(e) WHERE NOT EXISTS (SELECT 1 FROM jsonb_array_elements("RAJob"."marketTags") AS o(e) WHERE o.e->>'tag' = n.e->>'tag')), '[]'::jsonb) END, "archivedAt" = CASE WHEN "RAJob"."closeReason" IN ('source_removed', 'bank_closed', 'no_apply_target') THEN NULL WHEN "RAJob"."closeReason" = 'expired' AND (EXCLUDED."expiresAt" > now() OR (EXCLUDED."expiresAt" IS NULL AND EXCLUDED."sourceBoard" <> ALL(ARRAY['activejobs', 'linkedin', 'jsearch']::text[]))) THEN NULL ELSE "RAJob"."archivedAt" END, "closedAt" = CASE WHEN "RAJob"."closeReason" IN ('source_removed', 'bank_closed', 'no_apply_target') THEN NULL WHEN "RAJob"."closeReason" = 'expired' AND (EXCLUDED."expiresAt" > now() OR (EXCLUDED."expiresAt" IS NULL AND EXCLUDED."sourceBoard" <> ALL(ARRAY['activejobs', 'linkedin', 'jsearch']::text[]))) THEN NULL ELSE "RAJob"."closedAt" END, "closeReason" = CASE WHEN "RAJob"."closeReason" IN ('source_removed', 'bank_closed', 'no_apply_target') THEN NULL WHEN "RAJob"."closeReason" = 'expired' AND (EXCLUDED."expiresAt" > now() OR (EXCLUDED."expiresAt" IS NULL AND EXCLUDED."sourceBoard" <> ALL(ARRAY['activejobs', 'linkedin', 'jsearch']::text[]))) THEN NULL ELSE "RAJob"."closeReason" END WHERE "RAJob"."visibility" = 'public' RETURNING "id", "externalId", "sourceBoard", (xmax = 0) AS "inserted""`;

exports[`dedupe > MKT-3C step 1: exact twins share one dedupe key (K2 before K3) > the statement (snapshot): one UPDATE … RETURNING, every read and the write scoped to the market 1`] = `"WITH touched AS ( SELECT DISTINCT "atsPostingKey" FROM "RAJob" WHERE "market" = $1 AND "visibility" = 'public' AND "archivedAt" IS NULL AND "atsPostingKey" IS NOT NULL AND "dedupeKey" = ANY($2::text[]) ), best AS ( SELECT DISTINCT ON (j."atsPostingKey", coalesce(j."locationCountry", ''), lower(coalesce(j."locationCity", ''))) j."atsPostingKey", coalesce(j."locationCountry", '') AS "country", lower(coalesce(j."locationCity", '')) AS "city", j."dedupeKey" FROM "RAJob" AS j JOIN touched t ON t."atsPostingKey" = j."atsPostingKey" WHERE j."market" = $3 AND j."visibility" = 'public' AND j."archivedAt" IS NULL AND j."dedupeKey" IS NOT NULL ORDER BY j."atsPostingKey", coalesce(j."locationCountry", ''), lower(coalesce(j."locationCity", '')), j."sourcePriority" ASC, j."firstSeenAt" ASC, j."id" ASC ), moved AS ( SELECT j."id", j."dedupeKey" AS "fromKey", b."dedupeKey" AS "toKey" FROM "RAJob" AS j JOIN best b ON b."atsPostingKey" = j."atsPostingKey" AND b."country" = coalesce(j."locationCountry", '') AND b."city" = lower(coalesce(j."locationCity", '')) WHERE j."market" = $4 AND j."visibility" = 'public' AND j."archivedAt" IS NULL AND j."dedupeKey" IS DISTINCT FROM b."dedupeKey" ) UPDATE "RAJob" AS j SET "dedupeKey" = m."toKey" FROM moved m WHERE j."id" = m."id" AND j."market" = $5 RETURNING m."fromKey" AS "fromKey", m."toKey" AS "toKey""`;

exports[`dedupe > MKT-3C step 1: exact twins share one dedupe key (K2 before K3) > the statement (snapshot): one UPDATE … RETURNING, every read and the write scoped to the market 2`] = `"WITH touched AS ( SELECT DISTINCT "atsPostingKey" FROM "RAJob" WHERE "market" = $1 AND "visibility" = 'public' AND "archivedAt" IS NULL AND "atsPostingKey" IS NOT NULL AND "updatedAt" > now() - interval '2 days' ), best AS ( SELECT DISTINCT ON (j."atsPostingKey", coalesce(j."locationCountry", ''), lower(coalesce(j."locationCity", ''))) j."atsPostingKey", coalesce(j."locationCountry", '') AS "country", lower(coalesce(j."locationCity", '')) AS "city", j."dedupeKey" FROM "RAJob" AS j JOIN touched t ON t."atsPostingKey" = j."atsPostingKey" WHERE j."market" = $2 AND j."visibility" = 'public' AND j."archivedAt" IS NULL AND j."dedupeKey" IS NOT NULL ORDER BY j."atsPostingKey", coalesce(j."locationCountry", ''), lower(coalesce(j."locationCity", '')), j."sourcePriority" ASC, j."firstSeenAt" ASC, j."id" ASC ), moved AS ( SELECT j."id", j."dedupeKey" AS "fromKey", b."dedupeKey" AS "toKey" FROM "RAJob" AS j JOIN best b ON b."atsPostingKey" = j."atsPostingKey" AND b."country" = coalesce(j."locationCountry", '') AND b."city" = lower(coalesce(j."locationCity", '')) WHERE j."market" = $3 AND j."visibility" = 'public' AND j."archivedAt" IS NULL AND j."dedupeKey" IS DISTINCT FROM b."dedupeKey" ) UPDATE "RAJob" AS j SET "dedupeKey" = m."toKey" FROM moved m WHERE j."id" = m."id" AND j."market" = $4 RETURNING m."fromKey" AS "fromKey", m."toKey" AS "toKey""`;

exports[`dedupe > SQL ranks live public rows per key in the same order and only writes changed flags 1`] = `"WITH ranked AS ( SELECT "id", row_number() OVER w AS rn, first_value("id") OVER w AS canon FROM "RAJob" WHERE "market" = $1 AND "visibility" = 'public' AND "archivedAt" IS NULL AND "dedupeKey" = ANY($2::text[]) WINDOW w AS (PARTITION BY "dedupeKey" ORDER BY (CASE WHEN "locationCountry" = 'TW' AND "salaryDisclosed" THEN 0 ELSE 1 END) ASC, "sourcePriority" ASC, (CASE WHEN "atsType" IS NOT NULL THEN 0 ELSE 1 END) ASC, "postedAt" DESC NULLS LAST, "firstSeenAt" ASC, "id" ASC) ) UPDATE "RAJob" AS j SET "isCanonical" = (r.rn = 1), "canonicalJobId" = CASE WHEN r.rn = 1 THEN NULL ELSE r.canon END FROM ranked r WHERE j."id" = r."id" AND (j."isCanonical" IS DISTINCT FROM (r.rn = 1) OR j."canonicalJobId" IS DISTINCT FROM (CASE WHEN r.rn = 1 THEN NULL ELSE r.canon END))"`;
