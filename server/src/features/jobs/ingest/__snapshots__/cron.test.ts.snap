// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`maintenance SQL > archives a job only after 2 counted runs of the query that last returned it, inside that query's date window 1`] = `"UPDATE "RAJob" AS j SET "archivedAt" = now(), "closedAt" = now(), "closeReason" = 'source_removed', "updatedAt" = now() FROM "RAIngestQuery" q WHERE j."market" = $1 AND j."visibility" = 'public' AND j."archivedAt" IS NULL AND j."sourceBoard" = ANY($2::text[]) AND j."lastSeenQueryId" = q."id" AND q."provider" = $3 AND q."market" = $4 AND j."lastSeenRun" IS NOT NULL AND q."runCount" >= j."lastSeenRun" + $5::int AND ((CASE q."params"->>'datePosted' WHEN 'today' THEN 1 WHEN '3days' THEN 3 WHEN 'week' THEN 7 WHEN 'month' THEN 30 ELSE NULL END) IS NULL OR COALESCE(j."postedAt", j."firstSeenAt") > now() - make_interval(days => (CASE q."params"->>'datePosted' WHEN 'today' THEN 1 WHEN '3days' THEN 3 WHEN 'week' THEN 7 WHEN 'month' THEN 30 ELSE NULL END) - 1))"`;

exports[`maintenance SQL > expires public postings past their expiry or 45 days old — never a bank job or a public ATS board posting (WP-42) 1`] = `"UPDATE "RAJob" SET "archivedAt" = now(), "closedAt" = COALESCE("closedAt", now()), "closeReason" = 'expired', "updatedAt" = now() WHERE "market" = $1 AND "visibility" = 'public' AND "archivedAt" IS NULL AND "sourceBoard" <> ALL($2::text[]) AND ("expiresAt" < now() OR ("expiresAt" IS NULL AND "postedAt" < now() - make_interval(days => $3::int)))"`;
