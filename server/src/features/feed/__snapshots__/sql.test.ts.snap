exports[`statements > count: public rows only, capped inside (LIMIT cap + 1) 1`] = `
{
  "text": "SELECT count(*)::int AS "count" FROM (SELECT 1 FROM "RAJob" j LEFT JOIN "RACompany" c ON c."id" = j."companyId" WHERE j."market" = $1 AND j."isCanonical" = true AND j."archivedAt" IS NULL AND j."closedAt" IS NULL AND j."sourceBoard" <> 'seed' AND (j."fraudFlags" IS NULL OR jsonb_typeof(j."fraudFlags") <> 'array' OR j."fraudFlags" = '[]'::jsonb) AND j."visibility" = 'public' AND NOT EXISTS (SELECT 1 FROM "RAJobUserState" s WHERE s."userId" = $2 AND s."jobId" = j."id" AND s."hiddenAt" IS NOT NULL) AND (j."taxonomyIds" && $3::text[]) AND j."workModel" = ANY($4::text[]) AND j."skills" && $5::text[] LIMIT $6) AS capped",
  "values": [
    "intl",
    "u1",
    [
      "backend_engineer",
    ],
    [
      "remote",
    ],
    [
      "python",
    ],
    5001,
  ],
}
`;

exports[`statements > explore counts per L1 category over public live rows 1`] = `
{
  "text": "SELECT t.id AS "taxonomyId", count(*)::int AS "count" FROM "RAJob" j CROSS JOIN LATERAL unnest(j."taxonomyIds") AS t(id) WHERE j."market" = $1 AND j."isCanonical" = true AND j."archivedAt" IS NULL AND j."closedAt" IS NULL AND j."sourceBoard" <> 'seed' AND (j."fraudFlags" IS NULL OR jsonb_typeof(j."fraudFlags") <> 'array' OR j."fraudFlags" = '[]'::jsonb) AND j."visibility" = 'public' AND j."taxonomyIds" && $2::text[] AND t.id = ANY($3::text[]) GROUP BY t.id",
  "values": [
    "intl",
    [
      "software_engineering",
      "data_analytics",
    ],
    [
      "software_engineering",
      "data_analytics",
    ],
  ],
}
`;

exports[`statements > job ids (report sample): ids only, the list’s scope and predicates, newest first, LIMIT 1`] = `
{
  "text": "SELECT j."id" FROM "RAJob" j LEFT JOIN "RACompany" c ON c."id" = j."companyId" WHERE j."market" = $1 AND j."isCanonical" = true AND j."archivedAt" IS NULL AND j."closedAt" IS NULL AND j."sourceBoard" <> 'seed' AND (j."fraudFlags" IS NULL OR jsonb_typeof(j."fraudFlags") <> 'array' OR j."fraudFlags" = '[]'::jsonb) AND j."visibility" = 'public' AND NOT EXISTS (SELECT 1 FROM "RAJobUserState" s WHERE s."userId" = $2 AND s."jobId" = j."id" AND s."hiddenAt" IS NOT NULL) AND (j."taxonomyIds" && $3::text[]) AND j."workModel" = ANY($4::text[]) AND j."skills" && $5::text[] AND j."postedAt" >= $6::timestamp(3) ORDER BY j."postedAt" DESC NULLS LAST, j."id" DESC LIMIT $7",
  "values": [
    "intl",
    "u1",
    [
      "backend_engineer",
    ],
    [
      "remote",
    ],
    [
      "python",
    ],
    "2026-06-12T12:00:00.000Z",
    400,
  ],
}
`;

exports[`statements > retrieval: GoApply deadline orders by a stated, quoted close date (China date) and keeps undated jobs after it 1`] = `
{
  "text": "SELECT j."id", j."market", j."visibility", j."ownerUserId", j."title", j."titleNormalized", j."companyName", j."companyNameNormalized", j."companyId", j."companyLogoUrl", j."taxonomyIds", j."primaryTaxonomyId", j."seniority", j."roleType", j."minYears", j."maxYears", j."educationLevel", j."skills", j."skillsDetail", j."workModel", j."remoteScope", j."location", j."locationCity", j."locationCountry", j."geoLat", j."geoLng", j."employmentType", j."salaryMin", j."salaryMax", j."salaryCurrency", j."salaryPeriod", j."salaryAnnualMin", j."salaryAnnualMax", j."salaryDisclosed", j."salaryText", j."salaryMonths", j."sponsorship", j."sponsorshipEvidence", j."citizenshipRequired", j."clearanceRequired", j."employerTags", j."marketTags", j."postedAt", j."postedAtEstimated", j."firstSeenAt", j."lastSeenAt", j."expiresAt", j."sourceBoard", j."sourceName", j."originalSourceName", j."applyUrl", j."sourceUrl", j."atsType", j."isAgency", j."fromRecruiterBank", j."employerVerified", j."sourcePriority", j."archivedAt", (j."benefits" IS NOT NULL AND length(j."benefits") > 0) AS "hasBenefits", length(j."descriptionPlain")::int AS "descriptionLength", c."industries" AS "companyIndustries", c."sizeBand" AS "companySizeBand", c."facts" AS "companyFacts", c."displayName" AS "companyDisplayName", c."logoUrl" AS "companyLogo", j."skillIds", j."contentHash", j."lang", j."titleMatchScore" FROM "RAJob" j LEFT JOIN "RACompany" c ON c."id" = j."companyId" WHERE j."market" = $1 AND j."isCanonical" = true AND j."archivedAt" IS NULL AND j."closedAt" IS NULL AND j."sourceBoard" <> 'seed' AND (j."fraudFlags" IS NULL OR jsonb_typeof(j."fraudFlags") <> 'array' OR j."fraudFlags" = '[]'::jsonb) AND (j."visibility" = 'public' OR j."ownerUserId" = $2) AND (j."visibility" <> 'public' OR j."applyUrl" ~* '^[[:space:]]*https?://') AND NOT EXISTS (SELECT 1 FROM "RAJobUserState" s WHERE s."userId" = $3 AND s."jobId" = j."id" AND s."hiddenAt" IS NOT NULL) ORDER BY (SELECT min(substring(t.e->>'tag' from 14 for 10)) FROM jsonb_array_elements(CASE WHEN jsonb_typeof(j."marketTags") = 'array' THEN j."marketTags" ELSE '[]'::jsonb END) AS t(e) WHERE t.e->>'tag' ~ '^apply_closes:[0-9]{4}-[0-9]{2}-[0-9]{2}' AND length(btrim(COALESCE(t.e->>'evidenceQuote', ''))) > 0 AND substring(t.e->>'tag' from 14 for 10) >= $4) ASC NULLS LAST, j."postedAt" DESC NULLS LAST, j."id" DESC LIMIT $5",
  "values": [
    "cn",
    "u1",
    "u1",
    "2026-10-10",
    400,
  ],
}
`;

exports[`statements > retrieval: one window, newest first, LIMIT 1`] = `
{
