// ra-cn.prisma: GoApply / mainland models (ARCHITECTURE.md §2.12,
// TASK_PLAN.md R-17, CN_TW_LAUNCH_PLAN.md §4.1(4)). Added by FND-1b (Jobright clone).

/// Phone one-time codes (AUTH writes). The code is stored hashed.
model RAPhoneOtp {
  id         String    @id @default(cuid())
  brand      String
  phoneE164  String
  codeHash   String
  /// 'login' | 'bind' | 'change_old' | 'change_new' (WP-11)
  purpose    String
  attempts   Int       @default(0)
  ipHash     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// GoApply campus recruiting calendar (校招日历). Staff-curated from an official
/// page: paste the official URL → extractor proposes fields → a person verifies →
/// publish.
model RACampusEvent {
  id               String                 @id @default(cuid())
  market           String                 @default("cn")
  companyName      String
  companyId        String?
  /// Programme title, e.g. "2027届校园招聘".
  title            String
  /// e.g. '2027届'
  graduationClass  String
  /// 'application' | 'test' | 'interview' | 'info_session'
  kind             String                 @default("application")
  /// 网申 window.
  applyOpensAt     DateTime?
  applyClosesAt    DateTime?
  /// `[{ kind: 'wangshen'|'ceping'|'bishi'|'mianshi'|'offer'|'info_session', startsAt?, endsAt?, note? }]`
  stages           Json                   @default("[]")
  cities           String[]               @default([])
  roles            String[]               @default([])
  /// D3: every row MUST carry the employer's official URL; nothing is published
  /// without it, and the UI always links to it.
  officialUrl      String
  /// Where the details were read from, when it is not the official page.
  sourceUrl        String?
  sourceName       String?
  sourceNote       String?
  /// 'draft' | 'published' | 'archived'
  status           String                 @default("draft")
  /// Required to publish (app-enforced). Rows older than 14 days without
  /// re-verification show "待核实".
  verifiedAt       DateTime?
  verifiedByUserId String?
  /// Staff user id (no FK).
  createdBy        String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  subscriptions    RACampusSubscription[]

  @@index([market, status, graduationClass, applyClosesAt])
  @@index([companyName])
}

/// Deadline reminders for a campus event, or "follow a company" (kind 'company').
model RACampusSubscription {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'event' | 'company'
  kind                  String         @default("event")
  eventId               String?
  event                 RACampusEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// kind 'company': the followed company and 届别.
  companyNameNormalized String?
  graduationClass       String?
  /// 'email' | 'wechat' | 'in_app'
  channel               String         @default("in_app")
  remindAt              DateTime?
  lastNotifiedAt        DateTime?
  createdAt             DateTime       @default(now())

  @@unique([userId, eventId])
  @@unique([userId, kind, companyNameNormalized])
  @@index([eventId])
  @@index([companyNameNormalized, graduationClass])
}

/// GoApply employer block list (CN-E-08). Admin-curated; a blocked employer's
/// postings are flagged at ingest and kept out of feeds and Explore (SCHEMA-3,
/// SR-41-1). Until WP-41's store moves here it lives in AppConfig
/// `cn.jobs.employerBlacklist.v1`.
model RACnEmployerBlacklist {
  id           String   @id @default(cuid())
  market       String   @default("cn")
  /// As the admin typed it.
  employerName String
  /// `employerKey(employerName)` (features/cn/jobs/text.ts); short keys match
  /// at the start of a company name.
  employerKey  String   @unique
  reason       String
  /// Admin user id.
  createdBy    String
  createdAt    DateTime @default(now())
}

/// Admin review of a GoApply job's fraud flags (evidence retention, CN-E-08;
/// SCHEMA-3, SR-41-2). Until WP-41's store moves here it lives in AppConfig
/// `cn.jobs.fraudReviews.v1` (capped at 2,000 rows).
model RACnFraudReview {
  id          String   @id @default(cuid())
  jobId       String
  job         RAJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// `fraudSourceKey(sourceBoard, externalId)`: matches a re-ingested posting at
  /// afterNormalize, before it has a row id.
  sourceKey   String?
  /// 'clear' | 'confirm'
  decision    String
  note        String?
  /// Admin user id.
  by          String
  at          DateTime @default(now())
  /// `flagKey`s of the CN flags this review cleared (a re-run never brings them back).
  clearedKeys String[] @default([])
  /// The CN flags the job carried when reviewed: `[{ rule, evidence, at, ... }]`.
  flags       Json?

  @@index([jobId])
  @@index([sourceKey])
  @@index([decision, at])
}

/// GoApply 内推码 hub (WP-54, flag `cn.referralCodes`; SCHEMA-4, SR-54-1).
/// User-contributed referral codes. D3: shown only after moderation, labelled
/// "Shared by a %BRAND% user, {month year}"; never generated, never scraped.
model RACnReferralCode {
  id                String               @id @default(cuid())
  brand             String
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           String
  companyNormalized String
  code              String
  programme         String?
  expiresAt         DateTime?
  note              String?
  /// 'pending' | 'approved' | 'rejected' | 'expired' | 'deleted'
  /// 'deleted' = the sharer deleted it: soft delete, so it still counts toward
  /// the 10-a-day share cap; never listed, reported or moderated again.
  status            String               @default("pending")
  rejectReason      String?
  reportCount       Int                  @default(0)
  /// Set when reports take an approved code off the hub until re-review.
  hiddenAt          DateTime?
  moderatedAt       DateTime?
  /// Admin user id.
  moderatedById     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  reports           RACnReferralReport[]

  @@index([brand, status, companyNormalized])
  @@index([userId, createdAt])
}

/// A user's report of a 内推码 (one per user per code; SCHEMA-4, SR-54-1).
model RACnReferralReport {
  id        String           @id @default(cuid())
  codeId    String
  code      RACnReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  note      String?
  createdAt DateTime         @default(now())

  @@unique([codeId, userId])
}
