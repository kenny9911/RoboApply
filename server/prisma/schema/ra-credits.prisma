// ra-credits.prisma: CRED area models (ARCHITECTURE.md §2.11, §7; TASK_PLAN.md R-07).
// Added by FND-1b (Jobright clone). Practice minutes stay in
// SeekerSubscription.mockCredits + MockInterviewCreditLedger (mockCreditService).

/// Usage counter per bucket and window. An atomic conditional UPDATE enforces the cap (ARCH §7.3).
model RACreditWindow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bucket key (TASK_PLAN.md §4.1.f), e.g. 'tailor' | 'cover_letter' | 'ready_kits'.
  bucket    String
  /// 'd:2026-10-09' | 'w:2026-W41' | 'm:2026-10', in the user's time zone.
  windowKey String
  used      Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, bucket, windowKey])
}

/// Reserve → commit/release ledger, one row per metered action.
model RACreditLedger {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A credit bucket, or 'billing_event' for webhook replay claims (WP-21a; keyed
  /// 'billing:checkout:*' | 'billing:payfail:*' | 'billing:invoice:*', amount 0).
  bucket         String
  /// Units (positive = consumption).
  amount         Int
  /// 'reserved' | 'committed' | 'released'
  status         String
  /// 'window' | 'grant:<grantId>' (every plan has a cap, Pro included: fair-use caps, R-07)
  fromSource     String
  windowKey      String?
  /// '<userId>:<bucket>:<client Idempotency-Key or server ref>'
  idempotencyKey String    @unique
  /// 'tailor_session' | 'cover_letter' | 'autofill_run' | …
  refType        String?
  refId          String?
  /// UsageDeductionLog sku for the cost join.
  sku            String?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, bucket, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

/// Bonus credits (referral rewards, admin grants, purchased packs) consumed after the window allowance.
model RACreditGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A bucket, or '*' for any AI bucket.
  bucket    String
  amount    Int
  remaining Int
  /// 'referral' | 'admin' | 'pack' | 'compensation'
  reason    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, bucket, expiresAt])
}

/// Per-user overrides (beta flags, admin cap changes). Resolution order:
/// catalog → plan → override.
model RAEntitlementOverride {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'bucket:tailor' | 'entitlement:saved_searches' | 'flag:coaching'
  key       String
  /// number | boolean
  value     Json
  reason    String
  /// Admin user id (no FK; audit only).
  adminId   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, key])
}

/// Optional answer to the "Why are you cancelling?" survey shown after a
/// cancellation (WP-79; SCHEMA-6, SR-INT-1). POST /credits/cancel/survey only
/// records the answer here: it cancels nothing, sends no email and emits no
/// product event. Deleted with the account.
model RACancelSurvey {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand          String
  /// Reason code picked in the survey (e.g. 'found_job'); null = skipped.
  reason         String?
  /// Free text the person typed (optional, bounded by the route; never logged).
  note           String?  @db.Text
  /// The subscription the answer is about, when known (no FK; reference only).
  subscriptionId String?
  createdAt      DateTime @default(now())

  @@index([brand, createdAt])
  @@index([userId])
}

// ── Market wave (MKT-0; MARKET_STRATEGY 4.4, 5.1 "Refunds and disputes", 5.2 rule A8). Additive:
//    two new tables, no relation fields, no change to any existing billing table. ──

/// One refund, withdrawal, dispute or manual CN refund (MARKET_STRATEGY ST-4, ST-9, AL-7). Idempotency stays on
/// RACreditLedger claims; this row is the readable record (history marker, admin list, dispute flag). Insert-only.
model RABillingRefund {
  id                  String   @id @default(cuid())
  userId              String
  brand               String // 'roboapply' | 'goapply'
  rail                String // 'stripe' | 'alipay' | 'wechatpay'
  kind                String // 'refund' | 'withdrawal' | 'dispute' | 'manual_cn'
  /// Stripe: '<chargeId>:<amount_refunded>' or 'dispute:<disputeId>'; CN: 'order:<AlipayOrder.id>'
  externalRef         String
  chargeId            String?
  paymentIntentId     String?
  invoiceId           String?
  checkoutSessionId   String?
  alipayOrderId       String?
  planKey             String?
  amountMinor         Int
  currency            String
  full                Boolean  @default(false)
  entitlementReversed Boolean  @default(false)
  reason              String?
  /// Admin user id, 'self' (withdrawal) or 'stripe' (Dashboard refund, dispute)
  actor               String?
  note                String?  @db.Text
  createdAt           DateTime @default(now())

  @@unique([rail, externalRef])
  @@index([userId, createdAt(sort: Desc)])
  @@index([invoiceId])
  @@index([alipayOrderId])
  @@index([kind, createdAt])
}

/// Checkout acknowledgements kept after the account is deleted (California AB 2863: the later of 3 years after
/// consent and 1 year after the subscription ends). Written by the account purge, removed by compliance-daily. ST-9.
model RABillingConsentArchive {
  id                  String    @id @default(cuid())
  /// The deleted account's user id (no FK) and sha256 of its lower-cased email.
  userId              String
  emailHash           String
  brand               String
  consentType         String // 'auto_renew_ack' | 'withdrawal_waiver' | 'cn_pay_terms_ack'
  proseHash           String?
  proseVersion        String?
  consentedAt         DateTime
  subscriptionEndedAt DateTime?
  stripeCustomerId    String?
  retainUntil         DateTime
  createdAt           DateTime  @default(now())

  // One row per acknowledgement. Beyond the plan's list (MKT-0 review): the account purge can run twice
  // (a retry after a blocked storage cleanup, two overlapping sweeps), and a read-then-insert cannot keep
  // that to one row under concurrency. With this key the purge writes with
  // createMany({ skipDuplicates: true }) (MKT-4A). The table is new, so the key is additive, and it could
  // not be added safely once the table holds rows.
  @@unique([userId, consentType, consentedAt])
  @@index([retainUntil])
  @@index([emailHash])
  @@index([userId])
}
