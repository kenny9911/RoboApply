// ra-growth.prisma: GROW area models (ARCHITECTURE.md §2.12).
// Added by FND-1b (Jobright clone).

model RAReferralCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String
  /// 8 chars, Crockford base32.
  code      String   @unique
  createdAt DateTime @default(now())
}

model RAReferral {
  id            String    @id @default(cuid())
  brand         String
  inviterUserId String
  inviter       User      @relation("RAReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeUserId String    @unique
  invitee       User      @relation("RAReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  /// 'pending' | 'held' | 'rewarded' | 'qualified' | 'rejected' (SCHEMA-5, SR-60-2;
  /// growth/contract.ts REFERRAL_STATUSES). `pending` with `qualifiedAt` set =
  /// claimed for a reward, credits being written; `held` = the risk check holds
  /// the rewards for admin review; `qualified` = only the friend's credit was
  /// granted (inviter over the yearly cap or without a profile); `rejected`
  /// reasons include `same_person` and `invitee_no_profile`.
  status        String    @default("pending")
  riskScore     Int       @default(0)
  riskReasons   String[]  @default([])
  qualifiedAt   DateTime?
  rewardedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([inviterUserId, status])
  // SCHEMA-5 (SR-60-2): the admin held-rewards review list.
  @@index([brand, status])
}

/// First/last touch attribution captured at signup (F-ONB-02).
model RAAttribution {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonId     String?
  /// `{ from, utmSource, utmMedium, utmCampaign, ref, inviteCode, landingPath, jobId, at }`
  firstTouch Json
  lastTouch  Json?
  createdAt  DateTime @default(now())
}

/// Getting-started checklist progress (F-GROW-05; SCHEMA-2, SR-23-1). Functional
/// account state, not analytics: it outlives the event prune, does not depend
/// on analytics consent and is written only by the server through
/// growth.markChecklistStep() (never by the client). The first stamp wins.
model RAGrowthChecklist {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailorAt    DateTime?
  practiceAt  DateTime?
  saveJobAt   DateTime?
  /// The one-time practice-credit reward was granted (ledger key checklist_complete).
  rewardedAt  DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Invite-reward risk signals (F-GROW-01; SCHEMA-5, SR-60-1). Keyed hashes
/// only (HMAC; never a raw IP or User-Agent); deleted after 30 days by the
/// growth.referralSignalPrune worker, and with the account.
model RAReferralSignal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand      String
  ipHash     String?
  uaHash     String?
  deviceHash String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// One row per visitor: where they came from and how far they got toward an
/// account (visitor conversion; the admin "Visitors and sign-ups" report).
/// Written only by the events ingest (features/growth/visitors.ts), never by
/// the client directly. SCHEMA-9.
///
/// `anonId` is the first-party `ra_anon` id, so a row exists only where
/// analytics linking is allowed (everywhere consent is not required, and after
/// "Allow" in the EEA, the UK and Switzerland). A visitor who was not asked yet
/// or said no has no row: their page views are counted and linked to nothing
/// (RAProductEvent rows without an anonId). Kept at most 13 months after the
/// last visit (retention rule `product_events`); a row linked to an account is
/// deleted with it (cascade, and growth.deleteEventsForUser for the wipe).
model RAVisitor {
  id              String    @id @default(cuid())
  brand           String
  anonId          String
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  /// First-touch fields: set when the row is created, never overwritten.
  /// Path of the first page viewed (token routes and invite codes redacted).
  landingPath     String?
  referrerHost    String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  /// 'direct' | 'search' | 'ai' | 'social' | 'email' | 'paid' | 'campaign' | 'invite' | 'referral'
  /// (growth/visitors.ts VISITOR_CHANNELS).
  channel         String    @default("direct")
  /// ISO-3166 alpha-2 from the edge headers.
  country         String?
  /// 'desktop' | 'mobile' | 'tablet' (from the User-Agent; the string itself is not stored).
  device          String?
  locale          String?
  pageViews       Int       @default(0)
  /// Page loads (a new in-memory visit id) seen for this visitor.
  visits          Int       @default(1)
  lastVisitId     String?
  /// Funnel stamps. The first time wins.
  /// First view of the sign-up or sign-in page.
  signupViewedAt  DateTime?
  /// The `from` parameter of that view (which page's button sent them).
  signupFrom      String?
  /// First `signup_started` event (form submitted or a provider chosen).
  signupStartedAt DateTime?
  /// 'email' | 'google' | 'line' | 'phone' | 'wechat'
  signupMethod    String?
  /// The account's creation time, when it was created after this visitor was first seen.
  signedUpAt      DateTime?
  /// The visitor already had an account when first seen here (a new device or
  /// cleared cookies): not a conversion, left out of conversion rates.
  knownUser       Boolean   @default(false)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brand, anonId])
  @@index([brand, firstSeenAt])
  @@index([brand, lastSeenAt])
  @@index([userId])
}
