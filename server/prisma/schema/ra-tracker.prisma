// ra-tracker.prisma: TRK area models (ARCHITECTURE.md §2.1).
// Moved verbatim from the former single-file schema.prisma; no DDL change.
// The original RoboApply V2 section note lives at the top of ra-jobs.prisma.

/// User's Job Tracker rows.
/// Spec: 04-backend-spec.md §2.3.
model RATrackerEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String?
  job   RAJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// `{ title, companyName, location?, applyUrl }` captured at add-time so the
  /// row keeps rendering when jobId is null OR the linked RAJob was removed.
  externalSnapshot Json?

  /// `bookmarked | applying | applied | interviewing | negotiating | accepted | rejected | withdrawn`
  status            String    @default("bookmarked")
  excitementStars   Int       @default(0)
  maxSalary         Int?
  maxSalaryCurrency String?   @default("USD")
  notesMarkdown     String?   @db.Text
  dateSaved         DateTime  @default(now())
  dateApplied       DateTime?
  deadline          DateTime? // date-only semantics
  followUpAt        DateTime?
  /// 'ra_autoapply' | 'manual' | 'extension' | null
  appliedVia        String?

  /// Optional V1 `RoboApplyRun.id` if created by the V1 auto-apply flow.
  /// Read-only link — no FK constraint to avoid cross-namespace coupling.
  linkedRunId String?

  /// Soft-delete tombstone. When set, the row is hidden from every read path
  /// (list/board, counts, getById, patch, bulk, and the (userId, jobId)
  /// duplicate check) — the user can re-save the same job afterward. Mirrors
  /// the `RAResumeVariant.deletedAt` precedent; no hard delete anymore.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Jobright clone (FND-1b; ARCH §2.9) ──
  /// 'feed' | 'external' | 'extension' | 'copilot' | 'agent' | 'manual'
  source            String?
  /// GoApply sub-stage: 'wangshen' | 'ceping' | 'bishi' | 'ai_mianshi' | 'mianshi_1' |
  /// 'mianshi_2' | 'hr_mianshi' | 'offer' | 'sanfang'
  stageDetail       String?
  /// 'they_said_no' | 'i_withdrew' | 'job_pulled' (ruling C1)
  outcome           String?
  interviewAt       DateTime?
  /// User-entered: `{ base, currency, period, bonus?, equity?, deadline?, notes? }`
  offer             Json?
  tailoredVariantId String?
  coverLetterId     String?
  events            RATrackerEvent[]
  artifacts         RAApplicationArtifact[]

  /// Partial-unique semantics ("UNIQUE(userId, jobId) WHERE jobId IS NOT NULL")
  /// are enforced in application code in V2 — Prisma cannot express
  /// partial-unique. Application path: routes/tracker.ts POST checks for
  /// existing (userId, jobId) before insert and returns 409 'duplicate_tracker_entry'.
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, dateApplied(sort: Desc)])
  @@index([userId, followUpAt])
  @@index([userId, jobId])
  @@index([userId, deletedAt])
  @@index([linkedRunId])
  @@index([userId, interviewAt])
}

/// Weekly career-insight summary. One row per (userId, weekStartUtc).
/// Spec: 04-backend-spec.md §2.6.
model RACareerInsight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sunday-anchored UTC date. Date-only semantics on the wire.
  weekStartUtc DateTime

  /// ≤ 600 words, sanitised markdown.
  summaryMarkdown String   @db.Text
  /// Every `RATrackerEntry.id` referenced in the narration; CitationGuard
  /// verifies these against the user's tracker rows.
  citedTrackerIds String[] @default([])
  /// `{ applicationsCount, interviewsCount, offerCount, weeksToOfferEstimate?, … }`
  metrics         Json?

  /// Configured provider/model identifier used for this generation.
  modelUsed           String
  /// Forensic; canonical billing record is UsageDeductionLog.
  tokenCost           Decimal? @db.Decimal(10, 6)
  citationGuardPassed Boolean  @default(false)
  generatedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  @@unique([userId, weekStartUtc])
  @@index([weekStartUtc])
}

// ── Jobright clone: tracker history and files sent (FND-1b; ARCH §2.9) ────

/// Append-only history of a tracker entry.
model RATrackerEvent {
  id        String         @id @default(cuid())
  entryId   String
  entry     RATrackerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'status' | 'note' | 'reminder' | 'artifact' | 'interview' | 'outcome'
  kind      String
  fromValue String?
  toValue   String?
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
}

/// The exact file sent with an application (fixes "which resume did I send").
model RAApplicationArtifact {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackerEntryId String?
  trackerEntry   RATrackerEntry? @relation(fields: [trackerEntryId], references: [id], onDelete: SetNull)
  autofillRunId  String?
  /// 'resume' | 'cover_letter'
  kind           String
  variantId      String?
  coverLetterId  String?
  fileName       String
  /// 'pdf' | 'docx'
  format         String
  fileSha256     String
  /// R2 key of the exact bytes (kept 180 days).
  storageKey     String?
  /// 'extension' | 'download' | 'agent'
  channel        String
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([trackerEntryId])
}
