# ─────────────────────────────────────────────────────────────────────────────
# RoboApply — environment variables
#
# Local dev: copy to `.env` (loaded by server/src/app.ts + prisma) and put the
# NEXT_PUBLIC_* vars in `.env.local` for Next.js. On Vercel, set these in
# Project → Settings → Environment Variables (never commit real secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Express API port for local dev (the Next app runs on 3611).
PORT=4607

# ── Database (shared Neon with RoboHire for now) ────────────────────────────
# Runtime uses the POOLED (pgbouncer) Neon endpoint. For serverless, append
# ?pgbouncer=true&connection_limit=1 to the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT (non-pooler) endpoint — used ONLY by `prisma db push` / migrations
# (DDL over the transaction pooler silently no-ops).
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require

# ── Auth / cookies ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_EXPIRES_IN=30d
# For same-site cookies across roboapply.io and its api. Leave unset in dev.
# COOKIE_DOMAIN=.roboapply.io

# ── Public URLs (Next.js — put these in .env.local for dev) ─────────────────
# In PRODUCTION keep NEXT_PUBLIC_API_URL EMPTY so the browser calls same-origin
# /api/v1/* (Vercel rewrites route them to the Express function). In dev, the
# Next rewrite proxies /api/* to this backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:4607
NEXT_PUBLIC_ROBOAPPLY_URL=http://localhost:3611
# R2 public bucket URL for resumes/avatars via next/image. Optional.
NEXT_PUBLIC_R2_PUBLIC_URL=
# LiveKit signaling URL — needed for the mock-interview client. Optional.
NEXT_PUBLIC_LIVEKIT_URL=
# Used by outbound emails / OAuth redirects / public links in production.
APP_URL=https://roboapply.io
PUBLIC_APP_URL=https://roboapply.io

# ── Vercel Cron ─────────────────────────────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/v1/cron/* routes.
CRON_SECRET=change-me-to-a-long-random-string
# The in-process node-cron is auto-disabled on Vercel (VERCEL is set). Set this
# to true to disable it on any other always-on host too.
# ROBOAPPLY_CRON_DISABLED=false

# ── LLM providers ───────────────────────────────────────────────────────────
# Per-token costs are NOT configured here: the billed rates live in
# server/src/lib/modelCostTable.ts (rendered to docs/LLM_COSTS.md by
# `npm run llm:costs`). That command also reports which of the models selected
# below have no cost-table row and would bill at the default tier.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/google/gemini-3-flash-preview
# Task-specific model and reasoning-effort settings. Model values may use a
# direct provider prefix (deepseek/..., openai/...) or openrouter/... routing.
# Effort values: minimal|low|medium|high|max (provider support varies; the
# LiveKit interview worker supports minimal through high, not max).
LLM_MATCHING_MODEL=
LLM_MATCHING_REASONING_EFFORT=
LLM_EXTRACT_MODEL=
LLM_EXTRACT_REASONING_EFFORT=
LLM_ONBOARDING_MODEL=
LLM_ONBOARDING_REASONING_EFFORT=
LLM_REWRITE_MODEL=
LLM_REWRITE_REASONING_EFFORT=
LLM_INTERVIEW_MODEL=
LLM_INTERVIEW_REASONING_EFFORT=
# Live interviewer turns (the LiveKit worker). Unset → LLM_INTERVIEW_MODEL.
# The ALIGNED_INTERVIEW_MODELS allowlist applies to this value. When the
# effort is unset, reasoning families (openai gpt-5*/gpt-6*/gpt-oss/o-series)
# get 'low' and every other model gets none, so live turns stay fast.
LLM_INTERVIEW_LIVE_MODEL=
LLM_INTERVIEW_LIVE_REASONING_EFFORT=
# Blueprint/prompt generation during POST /sessions/:id/prepare. Unset →
# LLM_INTERVIEW_MODEL. A faster model here shortens the "Preparing" screen.
LLM_INTERVIEW_BLUEPRINT_MODEL=
LLM_INTERVIEW_BLUEPRINT_REASONING_EFFORT=
# Fallback route when the primary call fails. The admin DB override wins over
# this value. It is tried on auth/billing failures (401/402/403, "User not
# found.", invalid key, no credits) and on transient overload
# (429/503/timeout/empty output). Accepts any selector, e.g.
# google/gemini-3.8-flash or openrouter/openai/gpt-6-luna.
# When unset, an auth/billing failure still reroutes through the first DIRECT
# provider with a key (system DB key or env), in this order:
#   google/gemini-3.8-flash → anthropic/claude-sonnet-4-6 →
#   deepseek/deepseek-v4-flash → openai/gpt-6-luna
# The auto route never selects OpenRouter. It never applies to BYOK calls.
# A transient blip without a configured fallback stays on the primary, where
# withLLMRetry retries it. A provider whose platform key fails auth/billing is
# skipped for 10 minutes (an in-process circuit breaker); rotating the key
# closes the circuit at once.
LLM_FALLBACK_MODEL=
# Set to false to disable the auto-selected route (LLM_FALLBACK_MODEL still applies).
# LLM_FALLBACK_AUTO=true
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Global reasoning-effort dial, applied to every model that exposes one and
# silently ignored by those that don't. minimal|low|medium|high (OpenAI direct +
# OpenRouter); DeepSeek accepts high|max; Anthropic accepts low|medium|high|max.
# Unset = each provider's own default. Task-specific efforts above win, followed
# by admin/provider tuning and provider-specific env vars.
# LLM_REASONING_EFFORT=medium
# Optional DB-backed LLM settings kill-switch (true = pure-env behaviour).
# LLM_SETTINGS_DB_DISABLED=false

# ── Web search (RA insights / interview grounding) ──────────────────────────
TAVILY_API_KEY=

# ── Stripe (RoboApply consumer billing) ─────────────────────────────────────
STRIPE_SECRET_KEY=
# Webhook: point a Stripe endpoint at /api/v1/roboapply/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Or a RoboApply-specific secret if you split the endpoint:
# ROBOAPPLY_STRIPE_WEBHOOK_SECRET=
STRIPE_ROBOAPPLY_STARTER_PRICE_ID=
STRIPE_ROBOAPPLY_GROWTH_PRICE_ID=
STRIPE_ROBOAPPLY_PREMIUM_PRICE_ID=
STRIPE_ROBOAPPLY_PREMIUM_PLUS_PRICE_ID=
STRIPE_BILLING_PORTAL_URL=

# ── Alipay (RMB market) ─────────────────────────────────────────────────────
ALIPAY_API_URL=
ALIPAY_CALLBACK_SECRET=
# Optional callback origin override; defaults to https://www.roboapply.io.
# Must serve /api/v1/roboapply/billing/alipay/callback (not api.robohire.io).
# For local webhook testing, use the public URL of a tunnel to this API.
# BACKEND_URL=https://www.roboapply.io

# ── Interview Engine (LiveKit voice/video mock interviews) ──────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Object storage (R2 / S3 — resume originals + Egress recordings) ─────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# AWS_* fall-backs are also read by the AWS SDK.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
ROBOAPPLY_EMAIL_FROM=RoboApply <noreply@roboapply.io>

# ── External job boards / enrichment (optional) ─────────────────────────────
# The job-search workspace queries configured live sources. The three original
# RapidAPI job-search services share ONE key, but each
# service must be separately SUBSCRIBED on your RapidAPI app:
#   • JSearch            (jsearch.p.rapidapi.com)             — global aggregator
#   • Active Jobs DB     (active-jobs-db.p.rapidapi.com)      — direct-employer ATS
#   • LinkedIn Job Search(linkedin-job-search-api.p.rapidapi.com) — LinkedIn feed
# Each provider self-guards (in-process LRU cache + circuit breaker + a
# per-process daily billed-call budget) and NEVER throws — a missing key,
# missing subscription, or open breaker degrades that provider to silent no-op.
RAPID_API_KEY=
# Global kill switch — 'true' disables ALL external job providers at once.
RA_ONBOARDING_EXTERNAL_JOBS_DISABLED=
# Per-provider kill switches — 'true' hard-offs one provider without touching
# the key (e.g. to stop billing a service while keeping the others live).
RA_ONBOARDING_JSEARCH_DISABLED=
RA_ONBOARDING_ACTIVEJOBS_DISABLED=
RA_ONBOARDING_LINKEDIN_JOBS_DISABLED=
# Per-provider per-process daily billed-call budgets (integer; default 300).
# Sized to your RapidAPI monthly plan for that service ÷ ~30.
RA_ONBOARDING_JSEARCH_DAILY_BUDGET=
RA_ONBOARDING_ACTIVEJOBS_DAILY_BUDGET=
RA_ONBOARDING_LINKEDIN_JOBS_DAILY_BUDGET=
# Shared website/API search service. IDs: jsearch,activejobs,linkedin,hiringindex.
JOB_SEARCH_PROVIDERS=jsearch,activejobs
# External integration rights must be established independently of subscriptions.
# Empty means no provider data is returned through the partner API.
JOB_SEARCH_API_PROVIDERS=
JOB_SEARCH_DISABLED=
JOB_SEARCH_TIMEOUT_MS=20000
# Planning deadline; the agent uses the existing intent-parser/fast/default LLM settings.
JOB_SEARCH_AGENT_TIMEOUT_MS=15000
JOB_SEARCH_CACHE_TTL_MS=300000
# Durable search-attempt limits across replicas and all keys of each owner.
JOB_SEARCH_USER_PER_MINUTE=10
JOB_SEARCH_USER_DAILY_LIMIT=100
JOB_SEARCH_GLOBAL_DAILY_LIMIT=250
# Optional adapter, only used when explicitly allowlisted and subscribed.
JOB_SEARCH_HIRINGINDEX_DISABLED=
JOB_SEARCH_HIRINGINDEX_DAILY_BUDGET=100
GREENHOUSE_API_KEY=
LINKEDIN_ENRICH_API_KEY=

# ── Interview engine (LiveKit voice worker contract) ────────────────────────
# The control plane (this .env) and the worker (interview-agent/.env.local)
# MUST agree on these two values, or dispatches go to nobody / callbacks are
# rejected (empty transcripts + all-zero reports).
INTERVIEW_ENGINE_AGENT_NAME=RoboApply-Interview
LIVEKIT_AGENT_CALLBACK_SECRET=   # openssl rand -hex 24; same value in interview-agent/.env.local
# Public API origin the worker posts transcripts/lifecycle callbacks to. Set it
# explicitly in production. When unset in production (VERCEL=1 or
# NODE_ENV=production), the origin of the create request is used, but only if
# its host is on the allowlist (roboapply.io, robohire.io, goapply.top, the
# Vercel project URLs, plus the comma list below). Dev default:
# http://localhost:$PORT.
INTERVIEW_ENGINE_CALLBACK_BASE_URL=
INTERVIEW_ENGINE_CALLBACK_ALLOWED_HOSTS=
# Preparation limits: the web-evidence (Tavily) stage, and one whole prepare
# run. Keep the latter under the Vercel maxDuration (300 s).
INTERVIEW_ENGINE_WEB_EVIDENCE_TIMEOUT_MS=15000
INTERVIEW_ENGINE_PREPARE_TIMEOUT_MS=240000
# Record practice audio/video to R2. Opt-in: unset means off, so storing a
# session never starts silently once storage credentials work.
INTERVIEW_ENGINE_RECORDING_ENABLED=false
# Local node-cron schedule for expiring stale preparing/created/live sessions
# (Vercel runs /api/v1/cron/interview-cleanup from vercel.json instead).
ROBOAPPLY_INTERVIEW_CLEANUP_CRON=*/15 * * * *

# ── Parley pilot (practice interviews without LiveKit) ─────────────────────
# Parley is a standalone WebRTC interview service (its own VAD/STT/LLM/TTS):
# the browser connects to it directly, so a pilot session needs no LiveKit
# room, agent dispatch or interview-agent worker. Transcripts, scoring,
# reports and credits are unchanged. Off unless INTERVIEW_ENGINE_PARLEY_PILOT
# is "all" or a comma list of user emails / ids; decided once per session at
# creation, candidate practice only. Needs LIVEKIT_AGENT_CALLBACK_SECRET above.
# `npx tsx --env-file=.env scripts/parley-provision.ts --admin-password …`
# configures a Parley node and prints the PARLEY_* lines. Parley calls
# INTERVIEW_ENGINE_CALLBACK_BASE_URL + /api/v1/interview-engine/webhooks/parley.
# Production: deploy a node with Parley's deploy/deploy.sh (runbook in its
# deploy/README.md), then scripts/parley-vercel-env.sh <output> <allowlist>.
INTERVIEW_ENGINE_PARLEY_PILOT=off
PARLEY_URL=                 # e.g. http://localhost:8080 — the browser connects here too (https in production)
PARLEY_API_KEY=             # pk_…
PARLEY_WEBHOOK_SECRET=      # whsec_…
PARLEY_AGENT_ID=            # agt_… (STT/LLM/TTS stack; prompt/opening/language are per session)
PARLEY_TTS_PROFILES=        # optional voice per language, e.g. en:tts_…,zh:tts_…
PARLEY_WEBHOOK_BASE_URL=    # optional: origin Parley calls back at, e.g. http://host.docker.internal:4611 for Parley in local Docker

# ── Cross-bank job search (RoboApply candidate side) ──────────────────────
# The candidate app searches BOTH recruiter job banks at once. Each is a
# separate physical Postgres with the identical Prisma schema. Leave unset to
# fall back to the active brand's own DB (single-bank cross-DB is the safe
# default; reading the FOREIGN brand's bank additionally requires the
# cross-tenant sign-off flag below).
DATABASE_URL_ROBOHIRE=
DATABASE_URL_GOHIRE=
DIRECT_DATABASE_URL_ROBOHIRE=
DIRECT_DATABASE_URL_GOHIRE=
# Public job-detail bases for the synthesized apply links (defaults shown).
ROBOHIRE_PUBLIC_JOB_BASE_URL=https://www.robohire.io
GOHIRE_PUBLIC_JOB_BASE_URL=https://www.gohire.io
# GoHire resume parsing — primary extract+parse for plain PDF uploads.
# Without a key the ingest falls back to the local OCR pipeline, which is
# unreliable on image-only scans. GOHIRE_PARSE_ENABLED=false forces the fallback.
GOHIRE_API_KEY=
GOHIRE_API_BASE=https://api.gohire.top
GOHIRE_PARSE_ENABLED=true
GOHIRE_PARSE_TIMEOUT_MS=120000
# Kill switches + tuning.
RA_CROSSBANK_DISABLED=false
RA_CROSSBANK_ROBOHIRE_DISABLED=false
RA_CROSSBANK_GOHIRE_DISABLED=false
# Contractual white-label sign-off REQUIRED to read the FOREIGN brand's bank.
RA_CROSSBANK_CROSS_TENANT_CONFIRMED=false
RA_CROSSBANK_SCORER_BUDGET=16
RA_CROSSBANK_INVITE_OFFSET=0
RA_CROSSBANK_DAILY_CAP=25
# Per-agent model overrides (fall back to raModels tiers).
RA_V2_CROSSBANK_EXPLORER_MODEL=
RA_V2_CROSSBANK_INSIGHT_MODEL=
